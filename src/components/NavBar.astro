---
import "../styles/global.css";
import { Icon } from "astro-icon/components";
---

<div class="navbar-container">
    <div class="buttons">
            <Icon name="fa6-solid:moon" size={25} class={"icon-moon"} id={"icon-moon"}/>
            <Icon name="fa6-solid:sun" size={25} class={"icon-sun"} id={"icon-sun"}/>
    <button class="language-button" id="language-button">Es</button>
    </div>
    <div class="texts" id="texts">
        <a class="button-section"  href="#about-container">Sobre mi</a>
        <a class="button-section"  href="#projects-container">Proyectos</a>
        <a class="button-section" >Habilidades</a>
        <a class="button-section" >Trayectoria</a>
        <a class="button-section" >Contacto</a>
    </div>
</div>

<style>
    .navbar-container {
        background-color: color-mix(in srgb, var(--border) 60%, transparent);
        height: 4.5rem;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 2;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-inline: 5rem;
        backdrop-filter: blur(12px);
    }

    .buttons{
        display: flex;
        align-items: center;
        gap: 20px;
    }
    .icon-moon {
        display: inline;
        color: var(--primary);
    }
    .icon-sun {
        display: none;
        color: var(--primary);
    }

    .language-button {
        padding-inline: 1rem;
        padding-block: 0.2rem;
        user-select: none;
    }

    .texts {
        width: 30%;
        font-size: 1.2rem;
        display: flex;
        justify-content: space-between;
        user-select: none;
    }
    .texts a {
        color: var(--primary);
        font-weight: bold;
        text-decoration: none;
        user-select: none;
        padding-inline: 0.5rem;
    }
    .texts a:hover {
       cursor: pointer;
       background-color: var(--primary);
       color: var(--border);
       border-radius: var(--radius-md);
    }
</style>

<script>
    import gsap from "gsap";
    import {SplitText} from "gsap/SplitText";
    
    const language = document.querySelector<HTMLButtonElement>(".language-button")
    const moon = document.querySelector<HTMLButtonElement>(".icon-moon")
    const sun = document.querySelector<HTMLButtonElement>(".icon-sun")
    const texts = document.querySelector<HTMLButtonElement>(".texts")
    const buttons = document.querySelectorAll<HTMLElement>(".button-section")

    gsap.registerPlugin(SplitText)

    window.addEventListener("loader-finished", () => {
        gsap.fromTo(
            ".navbar-container", 
            {y: -1000},
            {y: 0, duration: 1.5}
        );
    })

    moon?.addEventListener("click", () => {
        if(!moon || !sun || !language || !texts) return
        moon.style.display = "none"
        sun.style.display = "inline"
        sun.style.color = "white"
        language.style = "color: white; border-color: white"
        texts.style = "color: white"
        document.documentElement.setAttribute("data-theme", "dark");
    })
    sun?.addEventListener("click", () => {
        if(!moon || !sun || !language || !texts) return
        moon.style.display = "inline"
        sun.style.display = "none"
        language.style = "border-color: var(--primary)"
        texts.style = "color: var(--primary)"
        document.documentElement.setAttribute("data-theme", "light");
    })
    language?.addEventListener("click", () => {
        language.textContent = language.textContent == "Es" ? "En" : "Es"
    })

    let active: (HTMLElement | null) = null
    buttons.forEach(button => {
        button.addEventListener("click", () => {
            if(active){
                (active as HTMLElement).style.background = "";  
                (active as HTMLElement).style.color = ""
            }
            active = button
            button.style.background = "var(--primary)"   
            button.style.color = "var(--border)"   
            button.style.borderRadius = "var(--radius-md)"   
        })
    })
</script>