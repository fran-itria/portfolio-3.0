---
import "../styles/global.css";
const name = "Franco Itria"
---

<div class="loader-container" id="page-loader">
    <div class="name-content">
            {name.split("").map(letter => {
                return <p>{letter}</p>
            })}
    </div>
    <span class="barra-container">
        <span class="loader" id="loader-bar"></span>
    </span>
    <p id="loader-number">0 %</p>
    <!-- <p id="click-here">Click para ver la página</p> -->
</div>

<style>
    p {
        font-size: 5rem;
        margin-right: 15px;
        margin-bottom: 0
    }

    #loader-number {
        font-size: 2rem;
        margin: 0;
    }

    .name-content {
        display: flex;
        justify-content: center;
        align-items: center;
    }
   .loader-container {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        background: var(--border);
        gap: 5px;
        transition:
            opacity 400ms ease,
            visibility 400ms ease;

        z-index: 9999;
    }

    .barra-container {
        display: block;
        margin-top: 10px;
        margin-bottom: 10px;
        width: 550px;
        height: 15px;

        border: 2px solid var(--primary);
        border-radius: 20px;

        overflow: hidden;
    }

    .loader {
        display: block;
        width: 0%;
        height: 100%;

        background: var(--primary);

        /* transition: width 2000ms ease; */
    }
    #click-here {
        margin: 0;
        display: flex;
        align-items: end;
        font-size: 2rem;
        opacity: 0;
        transition: opacity 1s ease;
    }
</style>

<script>
    import { gsap } from "gsap";
    const loader = document.querySelector<HTMLElement>("#page-loader");
    const loaderBar = document.querySelector<HTMLElement>("#loader-bar");
    const loaderNumber = document.querySelector<HTMLElement>("#loader-number");
    // const clickHere = document.querySelector<HTMLElement>("#click-here")

    let progress = 0;
    let pageLoaded = false

    // Bloquea el scroll mientras el loader esta en pantalla
    document.body.classList.add("loader-active");
    
    const startTime = Date.now();
    const minimumLoaderTime = 1500;

    gsap.to(".name-content p", {
        y: -15,
        duration: 0.4,
        ease: "sine.inOut",
        stagger: {
            each: 0.07,
            repeat: -1,
            yoyo: true
        }
    });

    const interval = setInterval(() => {
        if (!loaderBar || !loaderNumber) return;


        // Cada vez avanza un poco menos
        progress += Math.random() * 8;

        if (progress >= 90 && !pageLoaded) {
            progress = 90;
        }

        loaderBar.style.width = `${progress}%`;
        loaderNumber.textContent = `${Math.floor(progress)}%`;

        // Si ya cargó la página, terminamos
        if (pageLoaded && progress >= 100) {
            progress = 100;

            loaderBar.style.width = "100%";
            loaderNumber.textContent = "100%";

            gsap.killTweensOf(".name-content p");
            gsap.to(".name-content p", {
                y: 0,
                duration: 0.2
            });

            // clickHere.style.opacity = "1"
            clearInterval(interval);

            gsap.to("#page-loader", {
                y: -1000,
                duration: 0.4,
                stagger: {
                    each: 0.07,
                    yoyo: true
                },
                delay: 0.5
            });
            window.dispatchEvent(new Event("loader-finished"))
        }
    }, 100);

    window.addEventListener("load", () => {
        const elapsed = Date.now() - startTime;
        const remaining = Math.max(0, minimumLoaderTime - elapsed);

        setTimeout(() => {
            pageLoaded = true;
        }, remaining);
    });

</script>